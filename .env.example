# --- Wiro credentials (https://wiro.ai/panel -> Projects) ---
# Use a Signature-Based project so the secret never leaves your machine.
WIRO_API_KEY=
WIRO_API_SECRET=

# --- Model & defaults ---
# Default: the open-source model the user asked us to expose.
WIRO_MODEL=qwen/qwen3-8-27b-uncensored
# Wiro base URLs (no need to change unless Wiro rotates them)
WIRO_API_BASE=https://api.wiro.ai/v1
WIRO_WS_BASE=wss://socket.wiro.ai/v1

# --- Local gateway ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765

# --- Polling ---
# Wiro tasks are async; the gateway polls Task/Detail until terminal.
WIRO_POLL_INTERVAL_SEC=1.0
WIRO_POLL_TIMEOUT_SEC=600

# --- Reasoning effort (Qwen 3.8 27B Uncensored) ---
# What to use when the client doesn't ask for one. Mirrors `wiro.config.toml`'s
# `default_reasoning_effort` so the gateway default and the Codex profile stay
# in sync. Allowed: none | low | medium | high
# Aliases: off/disabled -> none, minimal -> low, med -> medium, max/maximum -> high
#   none    -- chat profile, thinking off (v0.1.0 default), temp 0.7, top_p 0.8
#   low     -- light reasoning, thinking on, temp 0.6, top_p 0.95
#   medium  -- balanced reasoning, thinking on, temp 0.6, top_p 0.95
#   high    -- deep reasoning, thinking on, temp 0.6, top_p 0.95
WIRO_DEFAULT_REASONING_EFFORT=none

# If true (default), the chosen effort's Wiro-recommended sampling
# (temperature / top_p / top_k / max_tokens) wins over the request body.
# If false, the body wins and the gateway only stamps the thinking toggles.
WIRO_PRESET_OVERRIDES_SAMPLING=true
