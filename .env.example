# --- Wiro credentials (https://wiro.ai/panel -> Projects) ---
# Use a Signature-Based project so the secret never leaves your machine.
WIRO_API_KEY=
WIRO_API_SECRET=

# --- Model & defaults ---
# Default: the open-source model the user asked us to expose.
WIRO_MODEL=qwen/qwen3-8-27b-uncensored
# Wiro base URLs (no need to change unless Wiro rotates them)
WIRO_API_BASE=https://api.wiro.ai/v1
WIRO_WS_BASE=wss://socket.wiro.ai/v1

# --- Local gateway ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765

# --- Polling ---
# Wiro tasks are async; the gateway polls Task/Detail until terminal.
WIRO_POLL_INTERVAL_SEC=1.0
WIRO_POLL_TIMEOUT_SEC=600
